{
    "name": "swh/user-profile-bundel",
    "description": "Symfony bundle do zarządzania profilem użytkownika (Bio) oraz przypisaną rolą, w architekturze DDD i CQRS",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/asset": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.0",
        "nelmio/api-doc-bundle": "^5.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/phpunit-bridge": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "SWH\\UserProfile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SWH\\UserProfile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "SWH\\UserProfile\\UserProfileBundle",
            "require": "8.1.*"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "vendor/bin/phpunit"
        ]
    },
    "minimum-stability": "stable"
}
