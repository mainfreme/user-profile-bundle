{
    "name": "mainfreme/user-profile-bundle",
    "description": "Symfony bundle do zarządzania profilem użytkownika (Bio) oraz przypisaną rolą, w architekturze DDD i CQRS",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/asset": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/http-foundation": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/messenger": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0",
        "symfony/twig-bundle": "^6.4|^7.0",
        "symfony/validator": "^6.4|^7.0",
        "symfony/yaml": "^6.4|^7.0",
        "twig/twig": "^3.0",
        "nelmio/api-doc-bundle": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/browser-kit": "^6.4|^7.0",
        "symfony/dotenv": "^6.4|^7.0",
        "symfony/phpunit-bridge": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Mainfreme\\UserProfile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mainfreme\\UserProfile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "Mainfreme\\UserProfile\\UserProfileBundle"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "vendor/bin/phpunit"
        ]
    },
    "minimum-stability": "stable"
}
